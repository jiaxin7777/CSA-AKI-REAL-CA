def plot_decision_curves(plot_data, dataset_name, save_dir):
    plt.figure(figsize=(10, 8))
    thresholds = np.arange(0.0, 1.01, 0.01)
    ref = next(iter(plot_data.values()))
    n_total = len(ref['true'])
    for name, d in plot_data.items():
        y_true, y_prob = d['true'], d['prob']
        nb = []
        for thr in thresholds:
            tp = np.sum((y_true == 1) & (y_prob >= thr))
            fp = np.sum((y_true == 0) & (y_prob >= thr))
            nb.append(tp / n_total - (fp / n_total) * (thr / (1 - thr + 1e-6)))
        plt.plot(thresholds, nb, linewidth=2, color=model_colors.get(name, 'gray'), label=name)
    plt.axhline(y=0, color='grey', linestyle='--', linewidth=1.5, label='不干预')
    all_nb = (np.sum(ref['true'] == 1) / n_total) - thresholds / (1 - thresholds + 1e-6) * (
            np.sum(ref['true'] == 0) / n_total)
    plt.plot(thresholds, all_nb, color='red', linestyle='--', linewidth=1.5, label='全部干预')
    plt.xlabel('阈值概率', fontweight='bold')
    plt.ylabel('净获益', fontweight='bold')
    plt.title(f'{dataset_name} 决策曲线分析', fontweight='bold', pad=20)
    plt.xlim([0, 1]); plt.ylim([-0.1, 0.5])
    plt.legend(loc='lower right', frameon=True, fancybox=True, shadow=True, framealpha=0.7)
    plt.grid(alpha=0.3)
    path = os.path.join(save_dir, f'decision_curve_{dataset_name}.pdf')
