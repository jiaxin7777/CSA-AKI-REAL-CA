class AKIDataset(Dataset):
    def __init__(self, dataframe):
        required = [ID_COL, TIME_COL, TARGET_COL]
        missing = [c for c in required if c not in dataframe.columns]
        if missing:
            raise ValueError(f'缺失必要列: {missing}')
        self.feature_names = [c for c in ALL_RAW_FEATURES if c in dataframe.columns]
        miss_feat = [c for c in ALL_RAW_FEATURES if c not in self.feature_names]
        if miss_feat:
            raise ValueError(f'缺失建模特征: {miss_feat}')
        self.input_dim = len(self.feature_names)
        self.patients = []
        self.aki_positive_indices = []
        self.aki_negative_indices = []

        for idx, (pid, g) in enumerate(dataframe.groupby(ID_COL)):
            g = g.sort_values(TIME_COL).reset_index(drop=True)
            self.patients.append({
                'features': g[self.feature_names].values.astype(np.float32),
                'labels': g[TARGET_COL].values.astype(np.int64),
                'seq_length': len(g),
                'patient_id': pid,
                'observationoffsets': g[TIME_COL].values.astype(np.int64),
            })
            if g[TARGET_COL].iloc[-1] == 1:
                self.aki_positive_indices.append(idx)
            else:
                self.aki_negative_indices.append(idx)

    def __len__(self):
        return len(self.patients)

    def __getitem__(self, idx):
        p = self.patients[idx]
        return (torch.FloatTensor(p['features']),
                torch.tensor(p['labels'], dtype=torch.long),
                p['seq_length'], p['patient_id'], p['observationoffsets'])

    def get_feature_names(self):
        return self.feature_names

    def get_input_dim(self):
        return self.input_dim

def collate_fn(batch):
    batch.sort(key=lambda x: (-x[2], x[3]))
    sequences, labels, lengths, patient_ids, observationoffsets = zip(*batch)
    padded_sequences = pad_sequence(sequences, batch_first=True)
    padded_labels = pad_sequence([lab.unsqueeze(1) for lab in labels],
                                 batch_first=True, padding_value=-100).squeeze(2)
    return (padded_sequences, padded_labels, torch.tensor(lengths),
            patient_ids, observationoffsets)

class TokenBudgetBatchSampler(torch.utils.data.Sampler):

    def __init__(self, lengths, max_tokens=MAX_TOKENS_PER_BATCH,
                 max_batch_size=MAX_BATCH_SIZE, shuffle=True, seed=CV_SEED):
        self.lengths = np.asarray(lengths, dtype=np.int64)
        self.max_tokens = int(max_tokens)
        self.max_batch_size = int(max_batch_size)
        self.shuffle = shuffle
        self.seed = seed
        self._epoch = 0

    def _build(self, epoch):
        n = len(self.lengths)
        rng = np.random.default_rng(self.seed + epoch)
        idx = rng.permutation(n).astype(np.int64) if self.shuffle else np.arange(n, dtype=np.int64)
        idx = idx[np.argsort(self.lengths[idx], kind='stable')]
        batches, cur, cur_tok = [], [], 0
        for i in idx:
            L = int(self.lengths[i])
            if cur and (cur_tok + L > self.max_tokens or len(cur) >= self.max_batch_size):
                batches.append(cur)
                cur, cur_tok = [], 0
            cur.append(int(i)); cur_tok += L
        if cur:
            batches.append(cur)
        if self.shuffle and len(batches) > 1:
            order = rng.permutation(len(batches))
            batches = [batches[k] for k in order]
        return batches

    def __iter__(self):
        batches = self._build(self._epoch)
        self._epoch += 1
        yield from batches

    def __len__(self):
        return len(self._build(0))

def make_loader(dataset, shuffle, num_workers=0):
    sampler = TokenBudgetBatchSampler(
        [p['seq_length'] for p in dataset.patients],
        max_tokens=MAX_TOKENS_PER_BATCH, max_batch_size=MAX_BATCH_SIZE,
        shuffle=shuffle, seed=CV_SEED)
    return DataLoader(dataset, batch_sampler=sampler, collate_fn=collate_fn,
                      num_workers=num_workers, pin_memory=True)

class LSTMModel(nn.Module):
    def __init__(self, input_dim, hidden_dim, num_layers, output_dim=2, dropout=0.5):
        super().__init__()
        self.lstm = nn.LSTM(input_size=input_dim, hidden_size=hidden_dim,
                            num_layers=num_layers, batch_first=True, bidirectional=False,
                            dropout=dropout if num_layers > 1 else 0)
        self.dropout = nn.Dropout(dropout)
        self.fc1 = nn.Linear(hidden_dim, hidden_dim)
        self.fc2 = nn.Linear(hidden_dim, output_dim)
        self.relu = nn.ReLU()

    def forward(self, x, seq_lengths):
        packed = pack_padded_sequence(x, seq_lengths.cpu().numpy(),
                                      batch_first=True, enforce_sorted=False)
        out, _ = self.lstm(packed)
        lstm_out, _ = pad_packed_sequence(out, batch_first=True)
        x = self.dropout(lstm_out)
        x = self.relu(self.fc1(x))
        return self.fc2(x), None

class MLPModel(nn.Module):
    def __init__(self, input_dim, hidden_dim, num_layers=2, output_dim=2, dropout=0.5):
        super().__init__()
        self.output_dim = output_dim
        layers = []
        prev = input_dim
        for _ in range(num_layers):
            layers.extend([nn.Linear(prev, hidden_dim), nn.BatchNorm1d(hidden_dim),
                           nn.ReLU(), nn.Dropout(dropout)])
            prev = hidden_dim
        self.mlp = nn.Sequential(*layers)
        self.fc_out = nn.Linear(hidden_dim, output_dim)

    def forward(self, x, seq_lengths):
        B, T, D = x.shape
        h = self.mlp(x.reshape(-1, D))
        return self.fc_out(h).view(B, T, self.output_dim), None

class MultiHeadSelfAttention(nn.Module):

    def __init__(self, hidden_dim, num_heads=4):
        super().__init__()
        assert hidden_dim % num_heads == 0, 'hidden_dim 必须能被 num_heads 整除'
        self.hidden_dim = hidden_dim
        self.num_heads = num_heads
        self.head_dim = hidden_dim // num_heads
        self.query = nn.Linear(hidden_dim, hidden_dim)
        self.key = nn.Linear(hidden_dim, hidden_dim)
        self.value = nn.Linear(hidden_dim, hidden_dim)
        self.out = nn.Linear(hidden_dim, hidden_dim)

    def forward(self, x, lengths):
        B, T, _ = x.shape
        Q = self.query(x).view(B, T, self.num_heads, self.head_dim).transpose(1, 2)
        K = self.key(x).view(B, T, self.num_heads, self.head_dim).transpose(1, 2)
        V = self.value(x).view(B, T, self.num_heads, self.head_dim).transpose(1, 2)

        ar = torch.arange(T, device=x.device)
        key_ok = ar.unsqueeze(0) < lengths.unsqueeze(1)         
        causal = ar.unsqueeze(0) <= ar.unsqueeze(1)             
        pad_q = ar.unsqueeze(0) >= lengths.unsqueeze(1)         
        keep = key_ok.unsqueeze(1) & (causal.unsqueeze(0) | pad_q.unsqueeze(2))

        context = F.scaled_dot_product_attention(Q, K, V, attn_mask=keep.unsqueeze(1), dropout_p=0.0)
        context = context.transpose(1, 2).contiguous().view(B, T, self.hidden_dim)
        return self.out(context), None

class PositionalEncoding(nn.Module):
    def __init__(self, hidden_dim):
        super().__init__()
        self.hidden_dim = hidden_dim

    def forward(self, x):
        B, T, H = x.shape
        position = torch.arange(T, device=x.device).unsqueeze(1)
        div_term = torch.exp(torch.arange(0, H, 2, device=x.device) * (-np.log(10000.0) / H))
        pe = torch.zeros(T, 1, H, device=x.device)
        pe[:, 0, 0::2] = torch.sin(position * div_term)
        pe[:, 0, 1::2] = torch.cos(position * div_term)
        pe = pe.expand(-1, B, -1).transpose(0, 1)
        return x + pe

class AttentionLSTMModel(nn.Module):

    def __init__(self, input_dim, hidden_dim, num_layers, output_dim=2, dropout=0.5,
                 num_heads=4, static_dim=N_STATIC, static_emb_dim=STATIC_EMB_DIM):
        super().__init__()
        self.dynamic_dim = input_dim
        self.static_dim = static_dim
        self.lstm = nn.LSTM(input_size=input_dim, hidden_size=hidden_dim,
                            num_layers=num_layers, batch_first=True, bidirectional=False,
                            dropout=dropout if num_layers > 1 else 0)
        self.proj = nn.Linear(hidden_dim, hidden_dim)
        self.ln1 = nn.LayerNorm(hidden_dim)
        self.pos_encoding = PositionalEncoding(hidden_dim)
        self.attention = MultiHeadSelfAttention(hidden_dim=hidden_dim, num_heads=num_heads)
        self.ln2 = nn.LayerNorm(hidden_dim)
        self.static_mlp = nn.Sequential(
            nn.Linear(static_dim, hidden_dim), nn.ReLU(), nn.Dropout(dropout),
            nn.Linear(hidden_dim, static_emb_dim), nn.ReLU()
        )
        self.dropout = nn.Dropout(dropout)
        self.fc1 = nn.Linear(hidden_dim + static_emb_dim, hidden_dim)
        self.fc2 = nn.Linear(hidden_dim, output_dim)
        self.relu = nn.ReLU()

    def forward(self, x, seq_lengths):
        x_dyn = x[:, :, :self.dynamic_dim]
        x_sta = x[:, :, self.dynamic_dim:self.dynamic_dim + self.static_dim]
        packed = pack_padded_sequence(x_dyn, seq_lengths.cpu().numpy(),
                                      batch_first=True, enforce_sorted=False)
        out, _ = self.lstm(packed)
        lstm_out, _ = pad_packed_sequence(out, batch_first=True)
        h = self.ln1(lstm_out + self.proj(lstm_out))
        h = self.pos_encoding(h)
        attn_out, attn_weights = self.attention(h, seq_lengths)
        h = self.ln2(h + attn_out)
        s = self.static_mlp(x_sta[:, 0, :])
        s = s.unsqueeze(1).expand(-1, h.size(1), -1)
        merged = torch.cat([h, s], dim=-1)
        z = self.dropout(merged)
        z = self.relu(self.fc1(z))
        logits = self.fc2(z)
        return logits, attn_weights

DEEP_MODEL_CLASSES = {'REAL-CA': AttentionLSTMModel, 'LSTM': LSTMModel, 'MLP': MLPModel}

def build_deep_model(model_name, params, device):
    cls = DEEP_MODEL_CLASSES[model_name]
    if model_name == 'REAL-CA':
        return cls(input_dim=params['input_dim'], hidden_dim=params['hidden_dim'],
                   num_layers=params['num_layers'], output_dim=params['output_dim'],
                   dropout=params['dropout'], num_heads=params.get('num_heads', 4),
                   static_dim=params.get('static_dim', N_STATIC),
                   static_emb_dim=params.get('static_emb_dim', STATIC_EMB_DIM)).to(device)
    return cls(input_dim=params['input_dim'], hidden_dim=params['hidden_dim'],
               num_layers=params['num_layers'], output_dim=params['output_dim'],
               dropout=params['dropout']).to(device)

def _tok_loss_safe(crit_tok, logits, labels):
    orig_det = torch.are_deterministic_algorithms_enabled()
    torch.use_deterministic_algorithms(False)
    loss = crit_tok(logits.transpose(1, 2), labels)
    torch.use_deterministic_algorithms(orig_det)
    return loss

def collect_deep_predictions(model, loader, device, class_weights):
    model.eval()
    crit_tok = nn.CrossEntropyLoss(
        ignore_index=-100,
        weight=torch.tensor(np.asarray(class_weights, dtype=np.float32), device=device),
        reduction='none')
    pids_out, offs_out, true_out, prob_out = [], [], [], []
    loss_sum, weight_sum = 0.0, 0.0
    with torch.no_grad():
        for inputs, labels, lengths, patient_ids, observationoffsets in loader:
            inputs, labels, lengths = inputs.to(device), labels.to(device), lengths.to(device)
            logits, _ = model(inputs, lengths)
            tok_loss = _tok_loss_safe(crit_tok, logits, labels)
            valid = (labels != -100).float()
            w = valid * (1.0 / lengths.float()).unsqueeze(1)
            loss_sum += float((tok_loss * w).sum())
            weight_sum += float(w.sum())

            probs = torch.softmax(logits, dim=2)
            ar = torch.arange(labels.shape[1], device=device).unsqueeze(0)
            mask = (ar < lengths.unsqueeze(1)) & (labels != -100)
            flat = mask.flatten()
            prob_out.extend(probs[:, :, 1].flatten()[flat].cpu().numpy())
            true_out.extend(labels.flatten()[flat].cpu().numpy())
            for i, pid in enumerate(patient_ids):
                L = lengths[i].item()
                pids_out.extend([pid] * L)
                offs_out.extend(observationoffsets[i][:L])
    avg_loss = loss_sum / weight_sum if weight_sum > 0 else 0.0
    return (np.array(pids_out), np.array(offs_out), np.array(true_out),
            np.array(prob_out), avg_loss)

def fit_deep_model(model_name, train_df, val_df, params, class_weights,
                   max_epochs, patience, seed, num_workers, desc=''):
    seed_everything(seed)
    device = get_device(model_name)
    train_ds = AKIDataset(train_df)
    val_ds = AKIDataset(val_df) if val_df is not None else None
    train_loader = make_loader(train_ds, shuffle=True, num_workers=num_workers)
    val_loader = make_loader(val_ds, shuffle=False, num_workers=num_workers) if val_ds is not None else None

    model = build_deep_model(model_name, params, device)
    w = torch.tensor(np.asarray(class_weights, dtype=np.float32), device=device)
    crit_tok = nn.CrossEntropyLoss(ignore_index=-100, weight=w, reduction='none').to(device)
    optimizer = optim.Adam(model.parameters(), lr=params['lr'], weight_decay=1e-5)
    scheduler = optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=max(max_epochs, 1), eta_min=params['lr'] / 20)

    best_auc, best_loss, best_epoch = -1.0, float('inf'), 0
    best_state = None
    stall = 0
    history = []
    for epoch in range(max_epochs):
        model.train()
        loss_sum, w_sum = 0.0, 0.0
        bar = tqdm(train_loader, desc=f'{desc} ep{epoch + 1}/{max_epochs}', leave=False)
        for inputs, labels, lengths, _, _ in bar:
            inputs, labels, lengths = inputs.to(device), labels.to(device), lengths.to(device)
            optimizer.zero_grad()
            logits, _ = model(inputs, lengths)
            tok_loss = _tok_loss_safe(crit_tok, logits, labels)
            if PATIENT_BALANCED_LOSS:
                valid = (labels != -100).float()
                pw = (1.0 / lengths.float()).unsqueeze(1)
                ww = valid * pw
                loss = (tok_loss * ww).sum() / ww.sum().clamp(min=1e-8)
            else:
                loss = tok_loss.mean()
            loss.backward()
            optimizer.step()
            loss_sum += float(loss.item())
            w_sum += 1
        train_loss = loss_sum / max(w_sum, 1)
        scheduler.step()

        if val_loader is not None:
            vp, vo, vy, vprob, vloss = collect_deep_predictions(model, val_loader, device, class_weights)
            v_auc, v_brier = quick_auc_brier(vy, vprob)
            history.append({'epoch': epoch + 1, 'train_loss': train_loss,
                            'val_loss': vloss, 'val_auc': v_auc, 'val_brier': v_brier})
            better = (v_auc > best_auc + 1e-6) or \
                     (abs(v_auc - best_auc) <= 1e-6 and vloss < best_loss)
            if better:
                best_auc, best_loss, best_epoch = v_auc, vloss, epoch + 1
                best_state = copy.deepcopy(model.state_dict())
                stall = 0
            else:
                stall += 1
                if stall >= patience:
                    break
        else:
            history.append({'epoch': epoch + 1, 'train_loss': train_loss})
            best_state = copy.deepcopy(model.state_dict())
            best_epoch = epoch + 1

    if best_state is None: 
        best_state = copy.deepcopy(model.state_dict())
        best_epoch = max_epochs
    model.load_state_dict(best_state)
    val_pred = None
    if val_loader is not None:
        vp, vo, vy, vprob, _ = collect_deep_predictions(model, val_loader, device, class_weights)
        val_pred = (vp, vo, vy, vprob)
    return {'model': model, 'best_state': best_state, 'best_epoch': best_epoch,
            'best_val_auc': best_auc, 'history': history, 'device': device,
            'val_pred': val_pred}

def predict_deep(model, df, class_weights, num_workers):
    device = next(model.parameters()).device
    ds = AKIDataset(df)
    loader = make_loader(ds, shuffle=False, num_workers=num_workers)
    pids, offs, true, prob, avg_loss = collect_deep_predictions(model, loader, device, class_weights)
    return pd.DataFrame({ID_COL: pids, TIME_COL: offs, 'true_label': true, 'pred_prob': prob}), avg_loss

def make_patient_folds(dev_df, n_folds=N_FOLDS, seed=CV_SEED):
    pat = dev_df.groupby(ID_COL)[TARGET_COL].max().rename('pat_label').reset_index()
    sgkf = StratifiedGroupKFold(n_splits=n_folds, shuffle=True, random_state=seed)
    folds = []
    for tr_idx, va_idx in sgkf.split(pat[[ID_COL]], pat['pat_label'], groups=pat[ID_COL]):
        folds.append((set(pat.iloc[tr_idx][ID_COL].values),
                      set(pat.iloc[va_idx][ID_COL].values)))
    print(f'✅ 已生成 {n_folds} 折患者级划分（StratifiedGroupKFold，按患者阳性分层）')
    for i, (tr, va) in enumerate(folds):
        print(f'   fold{i + 1}: 训练患者 {len(tr)}，留出患者 {len(va)}')
    return folds

def run_deep_cv(model_name, dev_df, folds, feature_dim, class_weights_full, num_workers):
    cfg = dict(DEEP_FIXED_PARAMS[model_name])
    if model_name == 'REAL-CA':
        cfg.update({'input_dim': N_DYNAMIC, 'static_dim': N_STATIC,
                    'static_emb_dim': STATIC_EMB_DIM, 'output_dim': 2})
    else:
        cfg.update({'input_dim': len(ALL_RAW_FEATURES), 'output_dim': 2})

    max_epochs = CV_EPOCHS[model_name]
    patience = CV_PATIENCE[model_name]
    rows = []
    fold_aucs, fold_briers, fold_epochs = [], [], []
    oof_parts = []

    for fi, (tr_pids, va_pids) in enumerate(folds):
        print(f'\n--- [{model_name}] 第 {fi + 1}/{N_FOLDS} 折 | 固定参数: {cfg} ---')
        tr_df = dev_df[dev_df[ID_COL].isin(tr_pids)]
        va_df = dev_df[dev_df[ID_COL].isin(va_pids)]
        cw = compute_class_weights(tr_df)
        seed = CV_SEED + fi
        fit = fit_deep_model(model_name, tr_df, va_df, cfg, cw,
                             max_epochs=max_epochs, patience=patience,
                             seed=seed, num_workers=num_workers,
                             desc=f'{model_name}-fold{fi + 1}')
        vp, vo, vy, vprob = fit['val_pred']
        auc, brier = quick_auc_brier(vy, vprob)
        fold_aucs.append(auc); fold_briers.append(brier); fold_epochs.append(fit['best_epoch'])
        oof_parts.append(pd.DataFrame({ID_COL: vp, TIME_COL: vo,
                                       'true_label': vy, 'pred_prob': vprob}))
        rows.append({'Model': model_name, 'fold': fi + 1,
                     'AUC': auc, 'Brier': brier, 'best_epoch': fit['best_epoch']})
        print(f'   fold{fi + 1} AUC={auc:.4f} Brier={brier:.4f} best_epoch={fit["best_epoch"]}')

    best = {
        'params': cfg,
        'mean_AUC': float(np.mean(fold_aucs)),
        'std_AUC': float(np.std(fold_aucs, ddof=0)),
        'mean_Brier': float(np.mean(fold_briers)),
        'median_best_epoch': int(np.ceil(np.median(fold_epochs))),
    }
    print(f'[{model_name}] 五折 CV AUC={best["mean_AUC"]:.4f}±{best["std_AUC"]:.4f} '
          f'(Brier={best["mean_Brier"]:.4f}，中位数 best_epoch={best["median_best_epoch"]})')

    oof_df = pd.concat(oof_parts, ignore_index=True)

    final_epochs = int(min(best['median_best_epoch'], FINAL_EPOCHS_CAP[model_name]))
    print(f'\n=== [{model_name}] 全开发集重训，固定 {final_epochs} 轮'
          f'（CV 中位数 best_epoch，封顶 {FINAL_EPOCHS_CAP[model_name]}）===')
    final_fit = fit_deep_model(model_name, dev_df, None, cfg, class_weights_full,
                               max_epochs=final_epochs, patience=final_epochs,
                               seed=CV_SEED + 1000, num_workers=num_workers,
                               desc=f'{model_name}-final')
    torch.save({'model_state_dict': final_fit['best_state'],
                'hyperparameters': cfg, 'feature_names': ALL_RAW_FEATURES,
                'final_epochs': final_epochs, 'cv_auc_mean': best['mean_AUC'],
                'cv_auc_std': best['std_AUC'],
                'save_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S')},
               os.path.join(model_dir, f'best_{model_name}_model.pth'))

    return {'cv_rows': rows, 'best': best,
            'oof_df': oof_df, 'final_model': final_fit['model']}

def get_traditional_feature_cols(df):
    cols = [c for c in df.columns if c not in TRAD_EXCLUDE_COLS]
    cols = [c for c in cols if pd.api.types.is_numeric_dtype(df[c])]
    return cols

def make_traditional_estimator(name, cfg, w_pos):
    cw = None if abs(w_pos - 1.0) < 1e-8 else {0: 1.0, 1: w_pos}
    if name == 'Logistic Regression':
        return LogisticRegression(C=cfg['C'], max_iter=2000, solver='lbfgs',
                                  class_weight=cw, random_state=CV_SEED)
    if name == 'Random Forest':
        return RandomForestClassifier(n_estimators=cfg['n_estimators'], max_depth=cfg['max_depth'],
                                      class_weight=cw, random_state=CV_SEED, n_jobs=-1)
    if name == 'XGBoost':
        return xgb.XGBClassifier(n_estimators=cfg['n_estimators'], max_depth=cfg['max_depth'],
                                 learning_rate=cfg.get('learning_rate', 0.1),
                                 random_state=CV_SEED, eval_metric='logloss',
                                 scale_pos_weight=w_pos, n_jobs=-1)
    if name == 'LightGBM':
        return lgb.LGBMClassifier(n_estimators=cfg['n_estimators'], num_leaves=cfg['num_leaves'],
                                  learning_rate=cfg.get('learning_rate', 0.1),
                                  random_state=CV_SEED, class_weight=cw, n_jobs=-1, verbose=-1)
    raise ValueError(f'未知传统模型: {name}')

def run_traditional_cv(model_name, train_df, internal_df, external_df, folds,
                       feature_cols, class_weights_full):
    cfg = dict(TRAD_FIXED_PARAMS[model_name])
    w_pos_full = float(class_weights_full[1])
    X_tr = train_df[feature_cols].values
    y_tr = train_df[TARGET_COL].values
    pids_tr = train_df[ID_COL].values

    fold_masks, fold_weights = [], []
    for tr_pids, va_pids in folds:
        tr_mask = np.fromiter((p in tr_pids for p in pids_tr), dtype=bool, count=len(pids_tr))
        va_mask = ~tr_mask
        cw = compute_class_weights(train_df[tr_mask])
        fold_masks.append((tr_mask, va_mask))
        fold_weights.append(float(cw[1]))

    rows = []
    fold_aucs, fold_briers = [], []
    oof_prob = np.full(len(train_df), np.nan)

    for fi, ((tr_mask, va_mask), w_pos) in enumerate(zip(fold_masks, fold_weights)):
        print(f'\n--- [{model_name}] 第 {fi + 1}/{N_FOLDS} 折 | 固定参数: {cfg} ---')
        est = make_traditional_estimator(model_name, cfg, w_pos)
        est.fit(X_tr[tr_mask], y_tr[tr_mask])
        vprob = est.predict_proba(X_tr[va_mask])[:, 1]
        oof_prob[va_mask] = vprob
        vy = y_tr[va_mask]
        auc, brier = quick_auc_brier(vy, vprob)
        fold_aucs.append(auc); fold_briers.append(brier)
        rows.append({'Model': model_name, 'fold': fi + 1,
                     'AUC': auc, 'Brier': brier, 'best_epoch': ''})
        print(f'   fold{fi + 1} AUC={auc:.4f} Brier={brier:.4f}')

    best = {
        'params': cfg,
        'mean_AUC': float(np.mean(fold_aucs)),
        'std_AUC': float(np.std(fold_aucs, ddof=0)),
        'mean_Brier': float(np.mean(fold_briers)),
        'median_best_epoch': '',
    }
    print(f'[{model_name}] 五折 CV AUC={best["mean_AUC"]:.4f}±{best["std_AUC"]:.4f}')

    oof_df = pd.DataFrame({ID_COL: pids_tr, TIME_COL: train_df[TIME_COL].values,
                           'true_label': y_tr, 'pred_prob': oof_prob})

    print(f'\n=== [{model_name}] 全训练集重训 ===')
    final_est = make_traditional_estimator(model_name, cfg, w_pos_full)
    final_est.fit(X_tr, y_tr)
    joblib.dump({'model': final_est, 'params': cfg, 'feature_cols': feature_cols,
                 'cv_auc_mean': best['mean_AUC'], 'cv_auc_std': best['std_AUC'],
                 'save_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S')},
                os.path.join(model_dir, f'best_{model_name}_model.pkl'))

    def _to_pred(df):
        prob = final_est.predict_proba(df[feature_cols].values)[:, 1]
        return pd.DataFrame({ID_COL: df[ID_COL].values, TIME_COL: df[TIME_COL].values,
                             'true_label': df[TARGET_COL].values, 'pred_prob': prob})

    internal_pred = _to_pred(internal_df)
    external_pred = _to_pred(external_df)
    return {'cv_rows': rows, 'best': best,
            'oof_df': oof_df, 'internal_df': internal_pred,
            'external_df': external_pred, 'final_model': final_est}

