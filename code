def find_optimal_threshold(y_true, y_prob):
    y_true = np.asarray(y_true)
    y_prob = np.asarray(y_prob)
    if np.unique(y_true).size < 2:
        return {'Optimal Threshold': 0.5, 'Youden Index': 0.0,
                'Sensitivity': 0.0, 'Specificity': 0.0}
    fpr, tpr, thresholds = roc_curve(y_true, y_prob)
    valid = thresholds <= 1.0
    fpr, tpr, thresholds = fpr[valid], tpr[valid], thresholds[valid]
    youden = tpr - fpr
    best_idx = int(np.argmax(youden))
    best_thr = float(thresholds[best_idx])
    cm = confusion_matrix(y_true, (y_prob >= best_thr).astype(int), labels=[0, 1])
    tn, fp, fn, tp = cm.ravel()
    return {
        'Optimal Threshold': best_thr,
        'Youden Index': float(tpr[best_idx] - fpr[best_idx]),
        'Sensitivity': float(tp / (tp + fn)) if (tp + fn) > 0 else 0.0,
        'Specificity': float(tn / (tn + fp)) if (tn + fp) > 0 else 0.0,
    }

def calculate_ece(y_true, y_prob, n_bins=10):
    bins = np.linspace(0, 1, n_bins + 1)
    bin_indices = np.digitize(y_prob, bins, right=True) - 1
    ece = 0.0
    for i in range(n_bins):
        mask = (bin_indices == i)
        if np.sum(mask) == 0:
            continue
        prob_mean = np.mean(y_prob[mask])
        true_mean = np.mean(y_true[mask])
        bin_weight = np.sum(mask) / len(y_true)
        ece += bin_weight * np.abs(prob_mean - true_mean)
    return float(ece)

def compute_roc_auc_ci(y_true, y_prob, pids, n_bootstraps=N_BOOTSTRAP, alpha=0.05, seed=CV_SEED):
    y_true = np.asarray(y_true)
    y_prob = np.asarray(y_prob)
    pids = np.asarray(pids)
    if pids.size != y_true.size:
        uniq_ids = np.arange(y_true.size)
        idx_by_pid = {i: np.array([i]) for i in uniq_ids}
    else:
        uniq_ids = np.unique(pids)
        order = np.argsort(pids, kind='stable')
        sorted_pids = pids[order]
        lo = np.searchsorted(sorted_pids, uniq_ids, side='left')
        hi = np.searchsorted(sorted_pids, uniq_ids, side='right')
        idx_by_pid = {p: order[l:h] for p, l, h in zip(uniq_ids, lo, hi)}

    rng = np.random.default_rng(seed)
    aucs = []
    for _ in range(n_bootstraps):
        draw = rng.choice(uniq_ids, size=len(uniq_ids), replace=True)
        idx = np.concatenate([idx_by_pid[p] for p in draw])
        if np.unique(y_true[idx]).size < 2:
            continue
        aucs.append(roc_auc_score(y_true[idx], y_prob[idx]))
    if not aucs:
        return 0.0, 0.0
    lower, upper = np.percentile(aucs, [100 * alpha / 2, 100 * (1 - alpha / 2)])
    return float(lower), float(upper)

def compute_class_weights(df, mode=CLASS_WEIGHT_MODE, cap=CLASS_WEIGHT_CAP):
    pat_max = df.groupby(ID_COL)[TARGET_COL].max()
    n_pos_pat = int((pat_max == 1).sum())
    n_neg_pat = int((pat_max == 0).sum())
    n_pos_tok = int((df[TARGET_COL] == 1).sum())
    n_neg_tok = int((df[TARGET_COL] == 0).sum())

    if mode == 'fixed':
        w_pos = 1.8
    elif mode == 'none':
        w_pos = 1.0
    elif mode == 'patient_sqrt':
        w_pos = np.sqrt(n_neg_pat / n_pos_pat) if n_pos_pat > 0 else 1.0
    elif mode == 'patient_full':
        w_pos = n_neg_pat / n_pos_pat if n_pos_pat > 0 else 1.0
    elif mode == 'timepoint_sqrt':
        w_pos = np.sqrt(n_neg_tok / n_pos_tok) if n_pos_tok > 0 else 0.0
    elif mode == 'timepoint_full':
        w_pos = n_neg_tok / n_pos_tok if n_pos_tok > 0 else 1.0
    else:
        raise ValueError(f'未知 CLASS_WEIGHT_MODE: {mode}')

    w_pos_raw = float(w_pos)
    w_pos = float(min(w_pos, cap))
    print(f'  [权重] 患者级 阳{n_pos_pat}/阴{n_neg_pat}；时点级 正{n_pos_tok}/负{n_neg_tok}；'
          f'mode={mode} w_pos={w_pos_raw:.3f}'
          + (f' -> 截断 {w_pos:.3f}' if w_pos != w_pos_raw else ''))
    return np.array([1.0, w_pos], dtype=np.float64)

def evaluate_predictions(y_true, y_prob, threshold, pids=None, dataset_name='',
                         do_ci=True, ci_bootstraps=N_BOOTSTRAP):
    y_true = np.asarray(y_true)
    y_prob = np.asarray(y_prob)
    y_pred = (y_prob >= threshold).astype(int)

    if np.unique(y_true).size > 1:
        auc = float(roc_auc_score(y_true, y_prob))
        lower, upper = (compute_roc_auc_ci(y_true, y_prob, pids, n_bootstraps=ci_bootstraps)
                        if do_ci and pids is not None else (0.0, 0.0))
    else:
        auc, lower, upper = 0.0, 0.0, 0.0
    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])
    metrics = {
        'Dataset': dataset_name,
        'Threshold': threshold,
        'Samples': int(len(y_true)),
        'Positive': int(y_true.sum()),
        'AUC': auc,
        'AUC_95CI_lower': lower,
        'AUC_95CI_upper': upper,
        'Balanced_Acc': float(balanced_accuracy_score(y_true, y_pred)),
        'F1': float(f1_score(y_true, y_pred, zero_division=0)),
        'Accuracy': float(accuracy_score(y_true, y_pred)),
        'Precision': float(precision_score(y_true, y_pred, zero_division=0)),
        'Recall': float(recall_score(y_true, y_pred, zero_division=0)),
        'Brier': float(brier_score_loss(y_true, y_prob)),
        'ECE': float(calculate_ece(y_true, y_prob)),
        'Confusion_Matrix_TN_FP_FN_TP': cm.ravel().tolist(),
    }
    return metrics

def quick_auc_brier(y_true, y_prob):
    y_true = np.asarray(y_true)
    y_prob = np.asarray(y_prob)
    auc = float(roc_auc_score(y_true, y_prob)) if np.unique(y_true).size > 1 else 0.0
    brier = float(brier_score_loss(y_true, y_prob))
    return auc, brier

def delong_paired_test(y_true, prob_a, prob_b):
    from scipy import stats
    y_true = np.asarray(y_true)
    pos = y_true == 1
    neg = y_true == 0
    n_pos, n_neg = int(pos.sum()), int(neg.sum())
    if n_pos == 0 or n_neg == 0:
        return None
    pa, pb = np.asarray(prob_a), np.asarray(prob_b)
    Xa, Ya = pa[pos], pa[neg]
    Xb, Yb = pb[pos], pb[neg]

    def _kernel(x_pos, y_neg):
        diff = x_pos[:, None] - y_neg[None, :]
        return (diff > 0).astype(float) + 0.5 * (diff == 0).astype(float)

    A = _kernel(Xa, Ya)
    B = _kernel(Xb, Yb)
    auc_a, auc_b = float(A.mean()), float(B.mean())
    v10 = np.vstack([A.mean(axis=1), B.mean(axis=1)]) 
    v01 = np.vstack([A.mean(axis=0), B.mean(axis=0)]) 
    s10 = np.cov(v10, ddof=1)
    s01 = np.cov(v01, ddof=1)
    cov = s10 / n_pos + s01 / n_neg
    contrast = np.array([1.0, -1.0])
    var = float(contrast @ cov @ contrast)
    z = (auc_a - auc_b) / np.sqrt(max(var, 1e-12))
    p_value = float(2.0 * stats.norm.sf(abs(z)))
    return {'AUC_A': auc_a, 'AUC_B': auc_b, 'z': float(z), 'p_value': p_value}

