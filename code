    print('\n===== 加载数据 =====')
    train_df = pd.read_csv(os.path.join(preprocessed_dir, 'train_ready.csv'))
    internal_df = pd.read_csv(os.path.join(preprocessed_dir, 'val_ready.csv'))
    external_df = pd.read_csv(os.path.join(preprocessed_dir, 'test_ready.csv'))
    print(f'✅ train={train_df.shape}, internal={internal_df.shape}, external={external_df.shape}')

    def clean_label(v):
        return 1 if v in [1, 2, 3] else 0
    for df in (train_df, internal_df, external_df):
        df[TARGET_COL] = df[TARGET_COL].apply(clean_label)
    print(f'   患者数: train={train_df[ID_COL].nunique()}, '
          f'internal={internal_df[ID_COL].nunique()}, external={external_df[ID_COL].nunique()}')

    trad_feature_cols = get_traditional_feature_cols(train_df)
    fill_cols = sorted((set(ALL_RAW_FEATURES) | set(trad_feature_cols))
                       & set(train_df.columns) & set(internal_df.columns) & set(external_df.columns))
    for df_name, df in [('train', train_df), ('internal', internal_df), ('external', external_df)]:
        nan_cnt = df[fill_cols].isna().sum()
        nan_cnt = nan_cnt[nan_cnt > 0]
        if len(nan_cnt) > 0:
            print(f'⚠️ {df_name} 有 {len(nan_cnt)} 个建模特征含 NaN，统一填 0: {dict(list(nan_cnt.items())[:8])}')
            df[fill_cols] = df[fill_cols].fillna(0.0)
    print(f'✅ 深度模型 {len(ALL_RAW_FEATURES)} 维（{N_DYNAMIC} 动态+{N_STATIC} 静态）；传统模型 {len(trad_feature_cols)} 列')

    class_weights_full = compute_class_weights(train_df)
    print(f'   全训练集权重: {class_weights_full}')

    folds = make_patient_folds(train_df, N_FOLDS, CV_SEED)

    all_cv_rows = []
    all_best = []
    results = {} 

    if RUN_DEEP_MODELS:
        for model_name in ['REAL-CA', 'LSTM', 'MLP']:
            print(f'\n\n########## 深度模型 5 折 CV: {model_name} ##########')
            res = run_deep_cv(model_name, train_df, folds, None,
                              class_weights_full, num_workers)
            results[model_name] = res
            all_cv_rows.extend(res['cv_rows'])
            all_best.append({'Model': model_name, **{k: v for k, v in res['best'].items() if k != 'params'},
                             'params': json.dumps(res['best']['params'], ensure_ascii=False)})

    if RUN_TRAD_MODELS:
        for model_name in ['Logistic Regression', 'Random Forest', 'XGBoost', 'LightGBM']:
            print(f'\n\n########## 传统模型 5 折 CV: {model_name} ##########')
            res = run_traditional_cv(model_name, train_df, internal_df, external_df,
                                     folds, trad_feature_cols, class_weights_full)
            results[model_name] = res
            all_cv_rows.extend(res['cv_rows'])
            all_best.append({'Model': model_name, **{k: v for k, v in res['best'].items() if k != 'params'},
                             'params': json.dumps(res['best']['params'], ensure_ascii=False)})

    cv_detail = pd.DataFrame(all_cv_rows)
    cv_detail_path = os.path.join(cv_dir, 'cv_fold_detail.csv')
    cv_detail.to_csv(cv_detail_path, index=False)
    print(f'\n✅ CV 折明细已保存: {cv_detail_path}')

    summary_df = pd.DataFrame(all_best)
    summary_path = os.path.join(cv_dir, 'cv_summary.csv')
    summary_df.to_csv(summary_path, index=False)
    print(f'\u2705 五折 CV 汇总（固定超参数）已保存: {summary_path}')
    fixed_json = {r['Model']: {k: (v if not isinstance(v, np.generic) else v.item())
                               for k, v in json.loads(r['params']).items()}
                  for r in all_best}
    with open(os.path.join(cv_dir, 'fixed_hyperparams.json'), 'w', encoding='utf-8') as f:
        json.dump(fixed_json, f, ensure_ascii=False, indent=2)

    if RUN_DEEP_MODELS:
        for model_name in ['REAL-CA', 'LSTM', 'MLP']:
            print(f'\n--- {model_name} 内部测试集预测（全训练集重训模型）---')
            internal_pred, _ = predict_deep(results[model_name]['final_model'], internal_df,
                                            class_weights_full, num_workers)
            results[model_name]['internal_df'] = internal_pred
            print(f'--- {model_name} 外部测试集预测 ---')
            external_pred, _ = predict_deep(results[model_name]['final_model'], external_df,
                                            class_weights_full, num_workers)
            results[model_name]['external_df'] = external_pred

    print('\n===== 训练集 OOF 约登阈值与最终评估 =====')
    comparison_rows, comparison_rows_50 = [], []
    plot_oof, plot_internal, plot_external = {}, {}, {}
    thresholds_json = {}

    def _eval_set(df, tag, thr, do_ci):
        return evaluate_predictions(df['true_label'].values, df['pred_prob'].values, thr,
                                    pids=df[ID_COL].values, dataset_name=tag, do_ci=do_ci)

    for model_name, res in results.items():
        oof = res['oof_df'].copy()
        internal = res['internal_df'].copy()
        external = res['external_df'].copy()
        youden = find_optimal_threshold(oof['true_label'].values, oof['pred_prob'].values)
        thr = youden['Optimal Threshold']
        thresholds_json[model_name] = youden
        print(f'\n[{model_name}] OOF 约登阈值={thr:.4f}（J={youden["Youden Index"]:.4f}，'
              f'Sens={youden["Sensitivity"]:.4f}, Spec={youden["Specificity"]:.4f}）')

        save_prediction_df(oof, model_name, 'oof_train')
        save_prediction_df(internal, model_name, 'internal_test')
        save_prediction_df(external, model_name, 'external_test')

        m_oof = _eval_set(oof, 'OOF训练集(5折CV)', thr, do_ci=False)
        m_int = _eval_set(internal, '内部测试集', thr, do_ci=True)
        m_ext = _eval_set(external, '外部测试集', thr, do_ci=True)
        m_oof50 = _eval_set(oof, 'OOF训练集(5折CV)', 0.5, do_ci=False)
        m_int50 = _eval_set(internal, '内部测试集', 0.5, do_ci=False)
        m_ext50 = _eval_set(external, '外部测试集', 0.5, do_ci=False)
        for m in (m_oof, m_int, m_ext):
            m['Model'] = model_name
            m['CV_mean_AUC'] = float(res['best']['mean_AUC'])
            m['CV_std_AUC'] = float(res['best']['std_AUC'])
            comparison_rows.append(m)
        for m in (m_oof50, m_int50, m_ext50):
            m['Model'] = model_name
            comparison_rows_50.append(m)

        plot_oof[model_name] = {'true': oof['true_label'].values, 'prob': oof['pred_prob'].values,
                                'auc': m_oof['AUC']}
        plot_internal[model_name] = {'true': internal['true_label'].values, 'prob': internal['pred_prob'].values,
                                     'auc': m_int['AUC'], 'ci_lower': m_int['AUC_95CI_lower'],
                                     'ci_upper': m_int['AUC_95CI_upper']}
        plot_external[model_name] = {'true': external['true_label'].values, 'prob': external['pred_prob'].values,
                                     'auc': m_ext['AUC'], 'ci_lower': m_ext['AUC_95CI_lower'],
                                     'ci_upper': m_ext['AUC_95CI_upper']}

    with open(os.path.join(cv_dir, 'oof_youden_thresholds.json'), 'w', encoding='utf-8') as f:
        json.dump(thresholds_json, f, ensure_ascii=False, indent=2)

    comp_path = os.path.join(output_dir, 'all_models_comparison.csv')
    pd.DataFrame(comparison_rows).to_csv(comp_path, index=False)
    print(f'\n✅ 模型对比结果（OOF 约登阈值）已保存: {comp_path}')
    comp50_path = os.path.join(output_dir, 'all_models_comparison_thr0.5.csv')
    pd.DataFrame(comparison_rows_50).to_csv(comp50_path, index=False)
    print(f'✅ 模型对比结果（阈值 0.5 附表）已保存: {comp50_path}')

    print('\n===== 配对 DeLong 检验（REAL-CA vs 各模型）=====')
    delong_rows = []
    real_int = results['REAL-CA']['internal_df']
    real_ext = results['REAL-CA']['external_df']
    for model_name in ['LSTM', 'MLP', 'Logistic Regression', 'Random Forest', 'XGBoost', 'LightGBM']:
        for cohort, real_df in [('internal', real_int), ('external', real_ext)]:
            other_df = results[model_name][f'{cohort}_df']
            r = delong_paired_test(real_df['true_label'].values,
                                   real_df['pred_prob'].values,
                                   other_df['pred_prob'].values)
            if r is not None:
                delong_rows.append({'Cohort': cohort, 'Comparator': model_name,
                                    'AUC_REAL-CA': r['AUC_A'], 'AUC_Comparator': r['AUC_B'],
                                    'z': r['z'], 'p_value': r['p_value'],
                                    'p<0.05': r['p_value'] < 0.05})
                print(f'  [{cohort}] REAL-CA vs {model_name}: '
                      f'{r["AUC_A"]:.3f} vs {r["AUC_B"]:.3f}, z={r["z"]:.2f}, p={r["p_value"]:.4f}')
    delong_path = os.path.join(cv_dir, 'delong_REAL-CA_vs_comparators.csv')
    pd.DataFrame(delong_rows).to_csv(delong_path, index=False)
    print(f'✅ DeLong 检验结果已保存: {delong_path}')

    print('\n===== 绘制曲线 =====')
    for pdata, dname in [(plot_oof, 'OOF训练集（五折交叉验证）'),
                         (plot_internal, '内部测试集'),
                         (plot_external, '外部测试集')]:
        plot_roc_curves(pdata, dname, curve_dir)
        plot_calibration_curves(pdata, dname, calibration_dir)
        plot_decision_curves(pdata, dname, curve_dir)
    plot_cv_auc_bars(summary_df, cv_dir)

    env_info = {
        'run_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
        'started_at': t0.strftime('%Y-%m-%d %H:%M:%S'),
        'python': platform.python_version(),
        'pytorch': torch.__version__,
        'cuda_available': torch.cuda.is_available(),
        'sklearn': __import__('sklearn').__version__,
        'xgboost': xgb.__version__,
        'lightgbm': lgb.__version__,
        'pandas': pd.__version__,
        'numpy': np.__version__,
        'n_folds': N_FOLDS,
        'fold_strategy': 'StratifiedGroupKFold on training set (group=patientunitstayid, stratify=patient-level max(label))',
        'fast_mode': FAST_MODE,
        'threshold_rule': 'Youden index on pooled training-set OOF predictions; fixed for internal/external; thr=0.5 table attached',
        'class_weight_mode': CLASS_WEIGHT_MODE,
        'patient_balanced_loss': PATIENT_BALANCED_LOSS,
        'deep_features': f'{len(ALL_RAW_FEATURES)} ({N_DYNAMIC} dynamic + {N_STATIC} static)',
        'traditional_features': len(trad_feature_cols),
        'n_bootstrap_ci': N_BOOTSTRAP,
        'delong_test': 'paired DeLong, REAL-CA vs each comparator on internal/external',
        'data_dir': preprocessed_dir,
        'fixed_hyperparams': fixed_json,
    }
    with open(os.path.join(output_dir, 'environment_info.json'), 'w', encoding='utf-8') as f:
        json.dump(env_info, f, ensure_ascii=False, indent=2)

    print(f'\n======== 全部完成，用时 {datetime.now() - t0}，结束于 {datetime.now():%Y-%m-%d %H:%M:%S} ========')

if __name__ == '__main__':
    main()
